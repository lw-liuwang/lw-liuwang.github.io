---
import { getCollection } from 'astro:content';
import { ArrowRight, CodeXml, BookOpen, ArrowUpRight } from '@lucide/astro';
import ContributionEntry from './ContributionEntry.astro';
import Resume from './Resume.astro';
import { projects } from '../data/portfolio';
import { pathFor, date } from '../lib/site';
const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<div class="home-profile">
<section class="profile-intro" aria-labelledby="profile-name">
  <div class="profile-copy">
    <h1 id="profile-name">liu wang</h1>
    <div class="profile-links"><a href="https://github.com/lw-liuwang"><CodeXml size={16} />GitHub<ArrowUpRight size={14} /></a></div>
  </div>
  <img class="profile-avatar" src="/avatar.png?v=07f56da1a360" alt="liu wang's GitHub avatar" width="160" height="160" fetchpriority="high" />
</section>
<Resume />
</div>

<section class="selected-section">
  <div class="section-heading"><h2>Contributions</h2><a class="text-link" href={pathFor('contributions')}>All contributions<ArrowRight size={16} /></a></div>
  <div class="home-contributions">{cases.map((entry) => <ContributionEntry entry={entry} />)}</div>
</section>

<section id="projects" class="projects-section" aria-labelledby="projects-heading">
  <div class="section-heading"><h2 id="projects-heading">Projects</h2></div>
  {projects.map((project) => <article class="personal-project">
    <img class="personal-project-logo" src={project.logo} alt="" width="72" height="72" loading="lazy" />
    <div class="personal-project-copy">
      <h3><a href={project.url}>{project.name}<ArrowUpRight size={18} /></a></h3>
      <p>{project.description}</p>
      <div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div>
    </div>
  </article>)}
</section>

  <section class="writing-preview">
    <div class="section-heading"><h2>Writing & learning</h2><BookOpen size={20} class="muted-icon" /></div>
    {posts.length ? <div class="post-list">{posts.slice(0, 3).map((post) => <a class="post-row" href={pathFor(`writing/${post.data.slug}`)}><span>{post.data.title}</span><time>{date(post.data.date)}</time><ArrowUpRight size={16} /></a>)}</div> : <p class="quiet-copy">No posts yet.</p>}
    <a class="text-link" href={pathFor('writing')}>Visit the notebook<ArrowRight size={16} /></a>
  </section>
